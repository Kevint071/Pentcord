generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                 @id(map: "usuarios_pkey") @default(autoincrement())
  username            String              @db.VarChar(120)
  email               String?
  metodoAutenticacion MetodoAutenticacion @map("metodo_autenticacion")
  password            String?             @map("password")
  googleId            String?             @map("google_id")
  rol                 Rol                 @default(musico)
  fotoPerfilUrl       String?             @map("foto_perfil_url")
  creadoEn            DateTime            @default(now()) @map("creado_en")
  eliminadoEn         DateTime?           @map("eliminado_en")

  favoritos          Favorito[]
  versionesCreadas   Version[]  @relation("AutorVersion")

  @@map("users")
}

model Cancion {
  id          Int            @id @default(autoincrement())
  titulo      String         @db.VarChar(200)
  artista     String         @db.VarChar(200)
  estado      Estado         @default(pendiente)
  creadoEn    DateTime       @default(now()) @map("creado_en")
  eliminadoEn DateTime?      @map("eliminado_en")

  versiones Version[]

  @@map("canciones")
}

model Version {
  id                Int           @id @default(autoincrement())
  cancionId         Int           @map("cancion_id")
  autorId           Int           @map("autor_id")
  tonoOriginal      String        @map("tono_original") @db.VarChar(10)
  contenidoChordpro String        @map("contenido_chordpro")
  estado            Estado        @default(pendiente)
  creadoEn          DateTime      @default(now()) @map("creado_en")
  revisadoEn        DateTime?     @map("revisado_en")
  eliminadoEn       DateTime?     @map("eliminado_en")

  favoritos Favorito[]
  autor     User    @relation("AutorVersion", fields: [autorId], references: [id], onDelete: Restrict)
  cancion   Cancion @relation(fields: [cancionId], references: [id], onDelete: Restrict)

  @@map("versiones")
}

model Favorito {
  userId    Int      @map("user_id")
  versionId Int      @map("version_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  version Version @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@id([userId, versionId])
  @@map("favoritos")
}

enum MetodoAutenticacion {
  local
  google
}

enum Rol {
  musico
  administrador
}

enum Estado {
  pendiente
  verificada
  pendienteEliminacion
  eliminada
  rechazada
}