# Copia este archivo como `.env` y rellena los valores.
# NUNCA subas el `.env` real al repositorio.

# --- Base de datos (Neon / PostgreSQL) --- obligatoria
# Usada en src/lib/prisma.ts
DATABASE_URL=

# --- Sesión (JWT HS256, access token de 15 min) --- obligatoria
# Usada en src/lib/getUserFromToken.ts y en las rutas auth/login y auth/register
JWT_SECRET=

# --- Cloudinary (foto de perfil) --- obligatorias
# Usadas en src/lib/cloudinary.ts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth (HU-01) --- opcionales por ahora
# Login con Google todavía no está implementado (B.6 del plan): sin estas
# variables el resto de la app funciona con normalidad.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Refresh token --- decisión abierta #4 del plan
# El código que lo firma está comentado en auth/login y auth/register.
# Descomentar solo si se decide activar el refresh token de 7 días.
# JWT_REFRESH_SECRET=
